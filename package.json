{
  "name": "ocran-strategic-consulting",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "typegen": "sanity schema extract --path=./sanity/schema.json --enforce-required-fields --force && sanity typegen generate",
    "seed": "sanity exec sanity/seed/import.ts --with-user-token",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@sanity/client": "8.11.0",
    "@sanity/image-url": "2.1.1",
    "@sanity/vision": "6.20.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "next": "16.4.3",
    "next-sanity": "13.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanity": "6.20.0",
    "styled-components": "6.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.18.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.37.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "27.0.0",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
