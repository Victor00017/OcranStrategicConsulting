# Copy to .env.local — never commit real values
NEXT_PUBLIC_SITE_URL=https://www.ocranstrategicconsulting.com

# Sanity — the site builds without these; /studio shows setup steps until set (docs/SETUP.md §5)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=     # optional: only for a private dataset or draft previews
SANITY_API_WRITE_TOKEN=    # Editor token, server only — /api/contact saves enquiries (step 9)
SANITY_REVALIDATE_SECRET=

