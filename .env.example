# DATABASE_URL=

# Email
RESEND_API_KEY=
CONTACT_TO_EMAIL=          # destination inbox for enquiries — set in Vercel, not in code
EMAIL_FROM=website@ocranstrategicconsulting.com

# Spam protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

