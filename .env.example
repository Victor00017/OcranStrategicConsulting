# Copy to .env.local — never commit real values
NEXT_PUBLIC_SITE_URL=https://www.ocranstrategicconsulting.com

# Sanity — the site builds without these; /studio shows setup steps until set (docs/SETUP.md §5)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=     # optional: only for a private dataset or draft previews
SANITY_API_WRITE_TOKEN=    # Editor token, server only — /api/contact saves enquiries (step 9)
SANITY_REVALIDATE_SECRET=

# Phase 2 (book sales) — not used yet
# PAYSTACK_SECRET_KEY=
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# DATABASE_URL=

# Contact form email (D-028) — the only two values the form needs
RESEND_API_KEY=            # free Resend account, signed up WITH the consultant's address
CONTACT_TO_EMAIL=          # that same address (Resend's test sender can only mail the account owner)
# Later, once the mail domain is verified in Resend — leave unset until then or sending fails:
# EMAIL_FROM=Ocran Strategic Consulting <website@ocranstrategicconsulting.com>

# Spam protection — not used yet; honeypot + rate limit for now (D-028). Add if spam appears.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# On hold for Phase 1 (D-016) — gated resource downloads / newsletter, not used yet
# BREVO_API_KEY=
# BREVO_LIST_ID=
# DOWNLOAD_TOKEN_SECRET=     # random 32+ chars, used to sign download links
